{
	// Intentionally omit Expo's missing base configuration.
	"compilerOptions": {
		"types": ["react", "react-native"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"jsx": "react-native",
		"baseUrl": ".",
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "esnext",
		"paths": {
			"@/*": ["./*"]
		}
	},
	"exclude": ["node_modules", ".expo"]
}
