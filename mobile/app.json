{
  "expo": {
    "name": "MitMe",
    "slug": "mitme",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mitme",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#17132a",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0e0c18"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MitMe uses your camera for video meetings."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "MitMe uses your microphone for meetings and voice chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MitMe needs access to your photos to set your avatar."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "@livekit/react-native-expo-plugin"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mitme.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MitMe uses your camera for video meetings.",
        "NSMicrophoneUsageDescription": "MitMe uses your microphone for meetings.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bitcode": false
    },
    "android": {
      "package": "com.mitme.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17132a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "16dfcd42-9dde-4baf-9207-b5339dbb416a"
      }
    }
  }
}
